{
  "schema_version": 1,
  "description": "Static capability policy graph for Zoe (Ablation-Tool/zoe). Enforces CONSTITUTION.md Articles III, V, and VI: untrusted surfaces cannot pivot across contexts into host execution, credential access, forensic vaults, or external actuation.",
  "labels": {
    "READ_PUBLIC_DATA": { "severity": 0 },
    "READ_LOCAL_CORPUS": { "severity": 1 },
    "READ_INTERNAL_DATA": { "severity": 2 },
    "WRITE_EVIDENCE_LOCAL": { "severity": 2 },
    "WRITE_CONFIG": { "severity": 3 },
    "CALL_APPROVED_RESEARCH_API": { "severity": 2 },
    "CALL_EXTERNAL_UNRESTRICTED": { "severity": 4 },
    "READ_SECRETS": { "severity": 4 },
    "WRITE_CODE": { "severity": 4 },
    "WRITE_INFRA": { "severity": 5 },
    "EXEC_SHELL": { "severity": 5 },
    "ACCESS_FORENSIC_VAULT": { "severity": 5 }
  },
  "tools": {
    "dorothy_atlas_read": ["READ_PUBLIC_DATA"],
    "dorothy_biobert_screen": ["READ_LOCAL_CORPUS"],
    "gem_render_scene": ["READ_LOCAL_CORPUS", "WRITE_EVIDENCE_LOCAL"],
    "evidence_index_search": ["READ_LOCAL_CORPUS"],
    "domain_research_verify": ["READ_PUBLIC_DATA", "CALL_APPROVED_RESEARCH_API"],
    "warrant_librarian_query": ["READ_LOCAL_CORPUS"],
    "glance_schema_scan": ["READ_LOCAL_CORPUS"],
    "winnow_screen_findings": ["READ_LOCAL_CORPUS"],
    "pcse_fingerprint": ["READ_INTERNAL_DATA"],
    "farg_slipnet_reason": ["READ_LOCAL_CORPUS"],
    "color_cusum_guard": ["READ_INTERNAL_DATA"],
    "ablation_static_inspect": ["READ_LOCAL_CORPUS"],
    "pala_readonly_carve": ["READ_LOCAL_CORPUS", "WRITE_EVIDENCE_LOCAL"],
    "kevlar_mcp_proxy": ["READ_PUBLIC_DATA"],
    "mobile_card_sync": ["READ_PUBLIC_DATA"],
    "owner_actuation_host": ["EXEC_SHELL"],
    "owner_actuation_network": ["CALL_EXTERNAL_UNRESTRICTED"],
    "cerotto_vault_export": ["ACCESS_FORENSIC_VAULT"],
    "guarded_l4_code_evolve": ["WRITE_CODE"]
  },
  "contexts": {
    "external_mcp_ingress": {
      "trust": "untrusted",
      "tools": ["kevlar_mcp_proxy"],
      "allow_labels": ["READ_PUBLIC_DATA"],
      "can_invoke": ["zoe_clara_peer"]
    },
    "mobile_tiny_zoe": {
      "trust": "untrusted",
      "tools": ["mobile_card_sync", "dorothy_atlas_read"],
      "allow_labels": ["READ_PUBLIC_DATA"],
      "can_invoke": ["zoe_clara_peer"]
    },
    "web_research_ingress": {
      "trust": "untrusted",
      "tools": ["domain_research_verify"],
      "allow_labels": ["READ_PUBLIC_DATA", "CALL_APPROVED_RESEARCH_API"],
      "can_invoke": ["dorothy_research_plane"]
    },
    "zoe_clara_peer": {
      "trust": "semi_trusted",
      "tools": ["evidence_index_search", "color_cusum_guard", "pcse_fingerprint", "farg_slipnet_reason"],
      "allow_labels": ["READ_PUBLIC_DATA", "READ_LOCAL_CORPUS", "READ_INTERNAL_DATA"],
      "can_invoke": ["dorothy_research_plane"]
    },
    "dorothy_research_plane": {
      "trust": "semi_trusted",
      "tools": ["dorothy_atlas_read", "dorothy_biobert_screen", "warrant_librarian_query", "glance_schema_scan", "winnow_screen_findings", "gem_render_scene"],
      "allow_labels": ["READ_PUBLIC_DATA", "READ_LOCAL_CORPUS", "WRITE_EVIDENCE_LOCAL"],
      "can_invoke": []
    },
    "ablation_static_plane": {
      "trust": "semi_trusted",
      "tools": ["ablation_static_inspect", "pala_readonly_carve"],
      "allow_labels": ["READ_LOCAL_CORPUS", "WRITE_EVIDENCE_LOCAL"],
      "can_invoke": []
    },
    "owner_actuation_plane": {
      "trust": "trusted",
      "tools": ["owner_actuation_host", "owner_actuation_network"],
      "allow_labels": [],
      "require_approval_labels": ["EXEC_SHELL", "CALL_EXTERNAL_UNRESTRICTED"],
      "can_invoke": []
    },
    "cerotto_forensic_plane": {
      "trust": "trusted",
      "tools": ["cerotto_vault_export"],
      "allow_labels": [],
      "require_approval_labels": ["ACCESS_FORENSIC_VAULT"],
      "can_invoke": []
    },
    "l4_guarded_evolution_plane": {
      "trust": "trusted",
      "tools": ["guarded_l4_code_evolve"],
      "allow_labels": [],
      "require_approval_labels": ["WRITE_CODE"],
      "can_invoke": []
    }
  },
  "spof_budget": {
    "catastrophic_pivots": 0,
    "untrusted_reaches:EXEC_SHELL": 0,
    "untrusted_reaches:WRITE_INFRA": 0,
    "untrusted_reaches:WRITE_CODE": 0,
    "untrusted_reaches:READ_SECRETS": 0,
    "untrusted_reaches:ACCESS_FORENSIC_VAULT": 0,
    "untrusted_reaches:CALL_EXTERNAL_UNRESTRICTED": 0
  },
  "adversary_twin": {
    "max_hops": 4,
    "forbidden_combos": [
      ["untrusted", "EXEC_SHELL"],
      ["untrusted", "WRITE_INFRA"],
      ["untrusted", "WRITE_CODE"],
      ["untrusted", "READ_SECRETS"],
      ["untrusted", "ACCESS_FORENSIC_VAULT"],
      ["untrusted", "CALL_EXTERNAL_UNRESTRICTED"],
      ["semi_trusted", "EXEC_SHELL"],
      ["semi_trusted", "ACCESS_FORENSIC_VAULT"]
    ]
  }
}
