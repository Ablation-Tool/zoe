{
  "labels": {
    "READ_PUBLIC_DATA":  {"severity": 0},
    "READ_INTERNAL_DATA":{"severity": 2},
    "READ_SECRETS":      {"severity": 4},
    "WRITE_CONFIG":      {"severity": 3},
    "WRITE_INFRA":       {"severity": 5},
    "EXEC_SHELL":        {"severity": 5},
    "CALL_EXTERNAL_UNRESTRICTED": {"severity": 4}
  },

  "tools": {
    "kb_search":            ["READ_PUBLIC_DATA"],
    "read_app_logs":        ["READ_INTERNAL_DATA"],
    "vector_db_zoneB":      ["READ_INTERNAL_DATA"],
    "vector_db_zoneC":      ["READ_SECRETS"],
    "restart_service":      ["WRITE_INFRA"],
    "run_sql":              ["READ_INTERNAL_DATA", "WRITE_CONFIG"],
    "http_fetch":           ["CALL_EXTERNAL_UNRESTRICTED"]
  },

  "contexts": {
    "user_chatbot": {
      "trust": "untrusted",
      "tools": ["kb_search", "read_app_logs", "vector_db_zoneB"],
      "allow_labels": ["READ_PUBLIC_DATA", "READ_INTERNAL_DATA"]
    },
    "ops_analyst": {
      "trust": "semi_trusted",
      "tools": ["read_app_logs", "vector_db_zoneB"],
      "allow_labels": ["READ_INTERNAL_DATA"],
      "can_invoke": ["ops_executor"]
    },
    "ops_executor": {
      "trust": "trusted",
      "tools": ["run_sql", "restart_service"],
      "allow_labels": ["READ_INTERNAL_DATA", "WRITE_CONFIG"],
      "require_approval_labels": ["WRITE_INFRA"]
    }
  },

  "spof_budget": {
    "untrusted_reaches:READ_SECRETS": 0,
    "untrusted_reaches:WRITE_INFRA": 0,
    "catastrophic_pivots": 0
  },

  "adversary_twin": {
    "forbidden_combos": [
      ["untrusted", "WRITE_INFRA"],
      ["untrusted", "EXEC_SHELL"],
      ["untrusted", "READ_SECRETS"]
    ],
    "max_hops": 3
  }
}
