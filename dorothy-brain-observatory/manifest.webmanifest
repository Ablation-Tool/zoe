{
  "name": "Dorothy 3D Brain Observatory",
  "short_name": "Dorothy Brain",
  "description": "Offline-capable interactive 3D MNI152 human brain observatory with synchronized T1-MRI slices, 7 WebGL2 shaders, 25 verified plates, and 52 Brodmann areas.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070b12",
  "theme_color": "#070b12",
  "icons": [
    {
      "src": "assets/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/dorothy-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
