{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvailGate response envelope v1",
  "type": "object",
  "required": ["schema_version", "operation", "request_id", "status", "started_at", "completed_at", "elapsed_ms", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation": {"type": "string"},
    "request_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "status": {"enum": ["ok", "partial", "error"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "elapsed_ms": {"type": "number", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}},
    "query": {"type": "string"},
    "queries": {"type": "array", "items": {"type": "string"}},
    "providers": {"type": "array", "items": {"type": "object", "required": ["engine", "query", "status", "errors"]}},
    "results": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "url", "title", "snippet", "score", "engines", "components", "explanation"], "properties": {"kind": {"enum": ["page", "query_template"]}, "url": {"type": "string"}, "score": {"type": "number"}}}},
    "document": {"type": "object", "required": ["id", "requested_url", "final_url", "retrieved_at", "text", "text_hash", "truncated", "excerpts", "extractor_version"], "properties": {"text": {"type": "string"}, "text_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "truncated": {"type": "boolean"}, "excerpts": {"type": "array", "items": {"type": "object", "required": ["start", "end", "text", "offset_unit"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "text": {"type": "string"}, "offset_unit": {"const": "unicode_code_point"}}}}}},
    "cache": {"type": "object", "required": ["hit", "retrieved_at", "age_seconds", "expires_at"], "properties": {"hit": {"type": "boolean"}, "age_seconds": {"type": "number", "minimum": 0}}}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "search"}, "status": {"enum": ["ok", "partial"]}}}, "then": {"required": ["query", "queries", "providers", "results", "cache", "options", "effective_weights"]}},
    {"if": {"properties": {"operation": {"const": "read"}, "status": {"enum": ["ok", "partial"]}}}, "then": {"required": ["document", "cache"]}}
  ]
}
