# dBA (defenseBridge for ASR) — environment configuration
# Copy this file to .env and adjust for your deployment.
# All variables are optional; the defaults work for local development.

# Working directory for upload staging and sanitized output.
# Must be writable by the service user.
# In Docker, mount a volume here when callers retrieve files by path.
MD_TEMP_DIR=/tmp

# Maximum upload size in bytes. Default is 200 MiB.
# Enforced at the middleware layer before the body is spooled to disk.
MD_MAX_UPLOAD_BYTES=209715200

# Seconds before ffprobe is killed. Malformed containers can cause hangs.
MD_FFPROBE_TIMEOUT=30

# Seconds before ffmpeg is killed. Increase for large files or slow storage.
MD_FFMPEG_TIMEOUT=120

# Seconds before sanitized output files are swept from MD_TEMP_DIR.
# The sweep runs at startup and then on this interval.
MD_SANITIZED_TTL=300

# Maximum simultaneous ffprobe + ffmpeg subprocess pairs.
# Requests over this limit wait on an internal semaphore.
MD_MAX_CONCURRENT=10
