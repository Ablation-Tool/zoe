set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZOE_MINGW_ROOT)
set(ZOE_MINGW_ROOT "" CACHE PATH "LLVM-MinGW installation root")
if(NOT ZOE_MINGW_ROOT)
    message(FATAL_ERROR "Set ZOE_MINGW_ROOT to the LLVM-MinGW installation")
endif()
set(ZOE_WINDOWS_TRIPLE x86_64-w64-mingw32)
set(CMAKE_C_COMPILER "${ZOE_MINGW_ROOT}/bin/${ZOE_WINDOWS_TRIPLE}-clang")
set(CMAKE_CXX_COMPILER "${ZOE_MINGW_ROOT}/bin/${ZOE_WINDOWS_TRIPLE}-clang++")
set(CMAKE_RC_COMPILER "${ZOE_MINGW_ROOT}/bin/${ZOE_WINDOWS_TRIPLE}-windres")
set(CMAKE_FIND_ROOT_PATH "${ZOE_MINGW_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
