  "effect_presets": {
    "zoe_3d_master": {
      "label": "Zoe 3D Binaural Master",
      "description": "Preserves Zoe's Woodworth 3D binaural stereo space with silky studio dynamics",
      "filters": [
        "highpass=f=65",
        "acompressor=threshold=-18dB:ratio=1.8:attack=18:release=140:makeup=1.2",
        "alimiter=limit=0.95"
      ]
    },
    "zoe_velvet": {
      "label": "Zoe's Velvet Studio",
      "description": "Intimate warm studio compression with a whisper of room air",
      "filters": [
        "highpass=f=70",
        "acompressor=threshold=-18dB:ratio=2.2:attack=15:release=120:makeup=1.5",
        "aecho=0.88:0.9:18:0.08",
        "alimiter=limit=0.95"
      ]
    },
    "flat": {
      "label": "Clean / Dry",
      "description": "Pure unprocessed voice (EQ sliders still apply unless bypassed)",
      "filters": []
    },
    "podcast_pro": {
      "label": "Late-Night Broadcast",
      "description": "Punchy radio compression and crystal articulation",
      "filters": [
        "highpass=f=85",
        "acompressor=threshold=-20dB:ratio=3.2:attack=10:release=100:makeup=2.2",
        "crystalizer=i=1.4",
        "alimiter=limit=0.95"
      ]
    },
    "fireside": {
      "label": "Fireside Audiobook",
      "description": "Cozy rolled-off highs and gentle warmth for long listening",
      "filters": [
        "highpass=f=65",
        "lowpass=f=7500",
        "acompressor=threshold=-18dB:ratio=2.0:attack=20:release=160:makeup=1.3",
        "aecho=0.85:0.88:22:0.10",
        "alimiter=limit=0.95"
      ]
    },
    "cathedral": {
      "label": "Starlight Cathedral",
      "description": "Spacious ethereal multi-tap reverb for poetry and storytelling",
      "filters": [
        "highpass=f=80",
        "aecho=0.8:0.88:45|90:0.28|0.18",
        "acompressor=threshold=-18dB:ratio=2.0:attack=20:release=180:makeup=1.4",
        "alimiter=limit=0.95"
      ]
    },
    "vintage_radio": {
      "label": "1940s Warm Radio",
      "description": "Classic noir tube-radio bandpass and tight vintage compression",
      "filters": [
        "highpass=f=320",
        "lowpass=f=3400",
        "acompressor=threshold=-22dB:ratio=4.0:attack=8:release=80:makeup=2.5",
        "alimiter=limit=0.92"
      ]
    },
    "cyber_holo": {
      "label": "Neon Hologram",
      "description": "Futuristic sci-fi shimmer with subtle phaser and crisp space",
      "filters": [
        "highpass=f=120",
        "aphaser=in_gain=0.8:out_gain=0.85:delay=2.5:decay=0.35:speed=0.7:type=t",
        "aecho=0.85:0.85:16:0.14",
        "alimiter=limit=0.95"
      ]
    },
    "whisper_asmr": {
      "label": "Midnight Silk (ASMR)",
      "description": "Ultra-close intimate dynamics with soft breathy presence",
      "filters": [
        "highpass=f=60",
        "acompressor=threshold=-24dB:ratio=3.5:attack=12:release=150:makeup=2.0",
        "aecho=0.9:0.9:12:0.06",
        "alimiter=limit=0.92"
      ]
    },
    "vinyl_lofi": {
      "label": "Lo-Fi Study Tape",
      "description": "Warm analog tape rolloff with smooth relaxed dynamics",
      "filters": [
        "highpass=f=90",
        "lowpass=f=5600",
        "acompressor=threshold=-19dB:ratio=2.5:attack=18:release=140:makeup=1.5",
        "aecho=0.88:0.88:14:0.07",
        "alimiter=limit=0.95"
      ]
    },
    "stage_chorus": {
      "label": "Dreamwave Chorus",
      "description": "Subtle shimmering flanger and soft echo for dreamy narration",
      "filters": [
        "highpass=f=75",
        "flanger=delay=4:depth=1.5:regen=10:width=40:speed=0.45:shape=s",
        "aecho=0.85:0.88:28:0.14",
        "alimiter=limit=0.95"
      ]
    }
  },
