<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Zoe</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.9.1</string>
    <key>CFBundleVersion</key>
    <string>12</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Zoe uses Bluetooth Low Energy only when you explicitly start an offline SafeConvert Help Beacon or nearby scan, and stops automatically on exit.</string>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>comgooglemaps</string>
        <string>claude</string>
        <string>chatgpt</string>
        <string>grok</string>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Zoe reads on-device GPS and compass telemetry only after you tap Locate once or Live: On, and stops automatically when you leave Maps &amp; Safety.</string>
    <key>NSCameraUsageDescription</key>
    <string>Zoe uses the camera only after you start it, and analyzes one frame when you choose Inspect.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Zoe captures microphone audio only for a voice command, or an audio recording you explicitly start.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Zoe performs one-shot voice commands with on-device speech recognition when supported.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Zoe Trinity connects only to a laptop address and pairing code you explicitly provide for shared local experiments.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
